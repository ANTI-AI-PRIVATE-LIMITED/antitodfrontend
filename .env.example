# Copy to `.env` and fill in values. Never commit `.env`.

# Required: your honeypot / admin API base URL (no trailing slash)
VITE_BACKEND_URL=https://your-api.example.com

# NOTE: Third-party provider API keys (Gemini, IPData, Ransomware.live)
# are NO LONGER exposed in the client browser bundle.
# They are maintained exclusively server-side in the backend environment
# (e.g. GEMINI_API_KEY, IPDATA_API_KEY, RANSOMWARE_LIVE_API_KEY)
# and accessed via authenticated backend proxy endpoints (/AdminRoutes/proxy/*).
